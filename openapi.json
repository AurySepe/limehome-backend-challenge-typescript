{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "HealthController_healthCheck",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/booking": {
      "post": {
        "operationId": "BookingController_createBooking",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "400": {
            "description": "Booking creation failed due to date conflict or occupied unit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "The given guest name cannot book the same unit multiple times"
                }
              }
            }
          }
        },
        "tags": [
          "booking"
        ]
      }
    },
    "/api/v1/booking/{id}/extend": {
      "post": {
        "operationId": "BookingExtensionController_extendBooking",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Mandatory UUID string to prevent duplicate stay extensions",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtendBookingInputDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking extended successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "400": {
            "description": "Booking extension failed due to date conflict, invalid booking status, or missing/invalid Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "For the requested extension dates, the unit is already occupied"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Booking not found"
                }
              }
            }
          }
        },
        "tags": [
          "booking-extension"
        ]
      }
    }
  },
  "info": {
    "title": "Booking API",
    "description": "NestJS Booking Management API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "guestName": {
            "type": "string"
          },
          "unitID": {
            "type": "string"
          },
          "checkInDate": {
            "type": "string"
          },
          "numberOfNights": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "guestName",
          "unitID",
          "checkInDate",
          "numberOfNights"
        ]
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "guestName": {
            "type": "string"
          },
          "unitID": {
            "type": "string"
          },
          "checkInDate": {
            "format": "date-time",
            "type": "string"
          },
          "numberOfNights": {
            "type": "number"
          },
          "checkOutDate": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "guestName",
          "unitID",
          "checkInDate",
          "numberOfNights",
          "checkOutDate"
        ]
      },
      "ExtendBookingInputDto": {
        "type": "object",
        "properties": {
          "extraNights": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "extraNights"
        ]
      }
    }
  }
}